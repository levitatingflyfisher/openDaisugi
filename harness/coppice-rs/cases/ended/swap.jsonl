# The model and router swaps of the stack bar (F12a). agent.set_model: on a
# claude pty pane it sends /model NAME through the ready queue, so it goes
# only at an idle prompt; on a headless sprig pane the next turn runs with
# --model NAME (agent.prompt can carry model too); any other harness is
# refused with words. agent.set_router: a restart with a new base URL in the
# env, resuming the conversation in a new pane, refused when there is no
# conversation to resume. Only the operator runs the swaps. The gateway is
# http://127.0.0.1:{PORT} in the config; the pane gw listens there and says it
# takes the pane prefix (GET /_caps), so a swap to the gateway is allowed and
# its panes are stamped. Pane ids: gw, then cl (headless claude, then its
# resumed successors), and later ones below.
#!config gateway = "http://127.0.0.1:{PORT}"
#!config [harness.claude]
#!config command = "/bin/sh"
#!config args = ["-c", "exec sleep 600"]
#!env COPPICE_CLAUDE_BIN={FIXTURES}/adapters/fake-claude.sh
#!env COPPICE_SPRIG_BIN={FIXTURES}/adapters/fake-sprig.sh
{"id":"g0","cmd":"pane.create","cwd":"{FIXTURES}","cmd_argv":["/usr/bin/python3","-c","import http.server as h;H=type('H',(h.BaseHTTPRequestHandler,),{'do_GET':lambda s:(s.send_response(200),s.send_header('Content-Length','21'),s.end_headers(),s.wfile.write(b'{\"pane_prefix\": true}')),'log_message':lambda *a:None});h.HTTPServer(('127.0.0.1',{PORT}),H).serve_forever()"],"label":"gw"}
{"id":"$id","ok":true,"result":{"pane":"$gw"}}
