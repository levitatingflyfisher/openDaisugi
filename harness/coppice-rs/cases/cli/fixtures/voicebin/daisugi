#!/usr/bin/env python3
"""A fake daisugi for the voice supervisor cases. Only `daisugi voice serve`
is here. What it does comes from the file $HOME/fake-voice-mode, which a
case writes:

- (no file) or ok: answer /health with 200 until interrupted.
- nohelp: `voice serve --help` fails.
- notinstalled: say the voice extra is not installed, exit 1.
- die: say why, exit 3.
- busy: the first start says the port is in use and exits; the next one
  serves.
- exit: serve, but end with exit 3 once the mode file says exit, after
  writing ok back, so the restart serves.
- noengine: say the speech engine program is not on PATH (what a Go or
  Rust daisugi says), exit 3.
- slow: do not answer /health until the file $HOME/fake-voice-go exists.

`daisugi voice status --json` answers from $HOME/fake-voice-kind (python,
go or rust) and, while it exists, $HOME/fake-voice-fetch ("DONE TOTAL"). With
no kind file it fails, as a daisugi that has no such verb does.
"""

import http.server
import json
import os
import signal
import sys
import threading
import time

MODE = os.path.join(os.environ.get("HOME", "."), "fake-voice-mode")


def mode():
    try:
        with open(MODE, encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return "ok"


def read(name):
    try:
        with open(os.path.join(os.environ.get("HOME", "."), name), encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return None


def status():
    kind = read("fake-voice-kind")
    if kind is None:
        print("Error: No such command 'status'.", file=sys.stderr)
        return 2
    out = {"engine": "moonshine", "model": "small", "model_bytes": 142300974, "fetched": False}
    out["kind"] = kind
    fetch = read("fake-voice-fetch")
    if fetch:
        done, total = fetch.split()
        out["fetch"] = {"done": int(done), "total": int(total)}
    print(json.dumps(out))
    return 0


def main():
    args = sys.argv[1:]
    if args[:3] == ["voice", "status", "--json"]:
        return status()
    if args[:2] != ["voice", "serve"]:
        print("fake daisugi: only voice serve and voice status", file=sys.stderr)
        return 2
    m = mode()
    if "--help" in args:
        return 1 if m == "nohelp" else 0
    port = int(args[args.index("--port") + 1])
    token = args[args.index("--token-file") + 1]
    print(
        "fake daisugi: serve with a token file of",
        len(open(token).read().strip()),
        "chars",
        flush=True,
    )
    if m == "notinstalled":
        print("Error: the voice extra is not installed.", flush=True)
        return 1
    if m == "noengine":
        print(
            "moonshine-cli is not on PATH. Build it with clients/go/scripts/native.sh --moonshine, "
            "then try again.",
            flush=True,
        )
        return 3
    if m == "slow":
        while read("fake-voice-go") is None:
            time.sleep(0.1)
    if m == "die":
        print("boom: no model.", flush=True)
        return 3
    if m == "busy":
        marker = os.path.join(os.path.dirname(token), "busy-once")
        if not os.path.exists(marker):
            open(marker, "w").close()
            print("OSError: [Errno 98] Address already in use", flush=True)
            return 1

    class H(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            self.send_response(200 if self.path == "/health" else 404)
            self.end_headers()
            self.wfile.write(b"ok")

        def log_message(self, *a):
            pass

    srv = http.server.ThreadingHTTPServer(("127.0.0.1", port), H)
    signal.signal(signal.SIGINT, lambda *a: os._exit(0))
    signal.signal(signal.SIGTERM, lambda *a: os._exit(0))
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    while True:
        time.sleep(0.1)
        if mode() == "exit":
            with open(MODE, "w", encoding="utf-8") as f:
                f.write("ok")
            print("fake daisugi: told to exit", flush=True)
            os._exit(3)


sys.exit(main())
