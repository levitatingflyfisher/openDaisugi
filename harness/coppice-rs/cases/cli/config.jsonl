# The commands that read and write coppice.toml: project add, list and rm,
# open and new, and what Save writes back.
#!config default = "sh"
#!config [harness.sh]
#!config command = "/bin/sh"
#!config args = ["-c", "sleep 600"]
# Projects: pin, list, unpin, from coppice.toml.
{"id": "j0", "cli": ["project"]}
{"id": "$id", "ok": true, "result": {"code": 1}}
{"id": "j1", "cli": ["project", "bogus"]}
{"id": "$id", "ok": true, "result": {"code": 1}}
{"id": "j2", "cli": ["project", "list"]}
{"id": "$id", "ok": true, "result": {"code": 0}}
{"id": "j3", "cli": ["project", "add"]}
{"id": "$id", "ok": true, "result": {"code": 1}}
{"id": "j4", "cli": ["project", "add", "."]}
{"id": "$id", "ok": true, "result": {"code": 0}}
{"id": "j5", "cli": ["project", "add", "{START}"]}
{"id": "$id", "ok": true, "result": {"code": 0}}
{"id": "j6", "cli": ["project", "add", "{WORK}/nope"]}
{"id": "$id", "ok": true, "result": {"code": 1}}
{"id": "j7", "cli": ["project", "add", "{HOME}/.config/coppice/coppice.toml"]}
{"id": "$id", "ok": true, "result": {"code": 1}}
{"id": "j8", "cli": ["project", "add", "{FIXTURES}"]}
{"id": "$id", "ok": true, "result": {"code": 0}}
{"id": "j9", "cli": ["project", "list"]}
{"id": "$id", "ok": true, "result": {"code": 0}}
{"id": "j10", "cli": ["project", "list", "--json"]}
{"id": "$id", "ok": true, "result": {"code": 0}}
{"id": "j11", "cli": ["project", "list", "--bogus"]}
{"id": "$id", "ok": true, "result": {"code": 1}}
{"id": "j12", "file": "{HOME}/.config/coppice/coppice.toml"}
{"id": "$id", "ok": true, "result": "*"}
{"id": "j13", "cli": ["project", "rm"]}
{"id": "$id", "ok": true, "result": {"code": 1}}
{"id": "j14", "cli": ["project", "rm", "{WORK}/nope"]}
{"id": "$id", "ok": true, "result": {"code": 1}}
{"id": "j15", "cli": ["project", "rm", "{FIXTURES}"]}
{"id": "$id", "ok": true, "result": {"code": 0}}
{"id": "j16", "file": "{HOME}/.config/coppice/coppice.toml"}
{"id": "$id", "ok": true, "result": "*"}
# open and new with a config that has a harness.
{"id": "o1", "cli": ["open"]}
{"id": "$id", "ok": true, "result": {"code": 1}}
{"id": "o2", "cli": ["open", "sh"]}
{"id": "$id", "ok": true, "result": {"code": 0}}
{"id": "o3", "cli": ["sh", "-x"]}
{"id": "$id", "ok": true, "result": {"code": 0}}
{"id": "o4", "cli": ["open", "nope"]}
{"id": "$id", "ok": true, "result": {"code": 1}}
{"id": "o5", "cli": ["nope"]}
{"id": "$id", "ok": true, "result": {"code": 1}}
{"id": "o6", "cli": ["new", "--no-attach"]}
{"id": "$id", "ok": true, "result": {"code": 0}}
{"id": "o7", "cli": ["new"]}
{"id": "$id", "ok": true, "result": {"code": 0}}
{"id": "o8", "cli": ["new", "a", "b"]}
{"id": "$id", "ok": true, "result": {"code": 1}}
{"id": "o9", "cli": ["new", "start", "--no-attach"]}
{"id": "$id", "ok": true, "result": {"code": 0}}
{"id": "o10", "cli": ["new", "{START}", "--no-attach"]}
{"id": "$id", "ok": true, "result": {"code": 0}}
{"id": "o11", "cli": ["new", "nosuch"]}
{"id": "$id", "ok": true, "result": {"code": 1}}
{"id": "o12", "cli": ["new", "--no-attach", "{FIXTURES}"]}
{"id": "$id", "ok": true, "result": {"code": 1}}
{"id": "o13", "cli": ["pane", "list", "--json"]}
{"id": "$id", "ok": true, "result": {"code": 0}}
# open and new with no config file: the harnesses on PATH.
{"id": "q1", "cli": ["new"], "env": {"XDG_CONFIG_HOME": "{WORK}/empty"}}
{"id": "$id", "ok": true, "result": {"code": 1}}
{"id": "q2", "cli": ["open", "pi"], "env": {"XDG_CONFIG_HOME": "{WORK}/empty"}}
{"id": "$id", "ok": true, "result": {"code": 1}}
{"id": "q3", "cli": ["pi"], "env": {"XDG_CONFIG_HOME": "{WORK}/empty"}}
{"id": "$id", "ok": true, "result": {"code": 1}}
{"id": "q4", "cli": ["open", "zz"], "env": {"XDG_CONFIG_HOME": "{WORK}/fresh", "PATH": "{FIXTURES}/cli/bin:/usr/bin:/bin"}}
{"id": "$id", "ok": true, "result": {"code": 1}}
{"id": "q5", "cli": ["zz"], "env": {"XDG_CONFIG_HOME": "{WORK}/fresh", "PATH": "{FIXTURES}/cli/bin:/usr/bin:/bin"}}
{"id": "$id", "ok": true, "result": {"code": 1}}
{"id": "q6", "file": "{WORK}/fresh/coppice/coppice.toml"}
{"id": "$id", "ok": true, "result": {"missing": true}}
{"id": "q7", "cli": ["open", "pi", "--flag"], "env": {"XDG_CONFIG_HOME": "{WORK}/fresh", "PATH": "{FIXTURES}/cli/bin:/usr/bin:/bin"}}
{"id": "$id", "ok": true, "result": {"code": "*"}}
{"id": "q8", "file": "{WORK}/fresh/coppice/coppice.toml"}
{"id": "$id", "ok": true, "result": "*"}
{"id": "q9", "cli": ["new", "--no-attach"], "env": {"XDG_CONFIG_HOME": "{WORK}/fresh2", "PATH": "{FIXTURES}/cli/bin:/usr/bin:/bin"}}
{"id": "$id", "ok": true, "result": {"code": "*"}}
{"id": "q10", "file": "{WORK}/fresh2/coppice/coppice.toml"}
{"id": "$id", "ok": true, "result": "*"}
{"id": "q11", "cli": ["new"], "env": {"XDG_CONFIG_HOME": "{WORK}/nodefault"}}
{"id": "$id", "ok": true, "result": {"code": 1}}
# A config with no default harness.
{"id": "q12", "write": "{WORK}/nodef/coppice/coppice.toml", "text": "[harness.sh]\ncommand = \"/bin/sh\"\n"}
{"id": "$id", "ok": true, "result": {"written": true}}
{"id": "q13", "cli": ["new"], "env": {"XDG_CONFIG_HOME": "{WORK}/nodef"}}
{"id": "$id", "ok": true, "result": {"code": 1}}
