# The floor on a wide terminal, 200 columns by 50 rows: the rail and two
# live windows beside it. The floor runs in a pane of the alt server, as in
# rail.jsonl, and each "screen" is a checkpoint read through that server's
# libghostty-vt. The windows show the case server's panes through the
# floor's own attaches. A pane that prints is read only after 6 s of quiet,
# so its state does not follow the pty's timing. Every harness is a fake.
# Pane ids on the case's server: w1:p1 ask, w1:p2 cat, w1:p3 idle, w1:p4
# pi (headless, on the fake pi).
#!config default = "sh"
#!config [harness.sh]
#!config command = "/bin/sleep"
#!config args = ["600"]
#!env COPPICE_PI_BIN={FIXTURES}/adapters/fake-pi.sh
{"id": "p1", "cmd": "pane.create", "cwd": "{START}", "cmd_argv": ["/bin/sleep", "600"], "label": "e2e ask"}
{"id": "$id", "ok": true, "result": {"pane": "$ask"}}
{"id": "p2", "cmd": "pane.create", "cwd": "{START}", "cmd_argv": ["/bin/cat"], "label": "e2e cat"}
{"id": "$id", "ok": true, "result": {"pane": "$cat"}}
{"id": "p3", "cmd": "pane.create", "cwd": "{START}", "cmd_argv": ["/bin/sleep", "600"], "label": "e2e idle"}
{"id": "$id", "ok": true, "result": {"pane": "$idle"}}
{"id": "p4", "cmd": "pane.create", "kind": "headless", "harness": "pi", "cwd": "{START}", "label": "e2e pi"}
{"id": "$id", "ok": true, "result": {"pane": "$pi"}}
{"id": "r1", "cmd": "pane.report_state", "pane": "$ask", "event": {"v": 1, "ts": 1, "session_id": "s", "harness": "claude-code", "pane": "$ask", "state": "blocked", "source": "gate", "ask": {"id": "toolu_02", "tool": "Write", "summary": "src/main.py", "deadline": 4102444800, "tier": "undoable"}, "detail": "verdict=ask"}}
{"id": "$id", "ok": true, "result": {"pane": "$ask", "state": "blocked", "source": "gate"}}
{"id": "a1", "cli": ["server", "start"], "alt": true, "autostart": true}
{"id": "$id", "ok": true, "result": {"code": 0}}
{"id": "a2", "cli": ["pane", "create", "--json", "--label", "floor", "--kind", "pty", "--cols", "200", "--rows", "50", "--cwd", "{START}", "--", "/usr/bin/env", "-u", "COPPICE_PANE", "{BIN}", "--socket", "{SOCK}", "--data-dir", "{DATA}"], "alt": true}
{"id": "$id", "ok": true, "result": {"code": 0}}
# The floor opens with the agent that needs you in a window, typing there.
{"id": "open", "screen": "w1:p1", "alt": true, "until": "typing here"}
{"id": "$id", "ok": true, "result": {"rows": "*"}}
# The leave key gives the keys back to the rail.
{"id": "k1", "cli": ["pane", "send-keys", "w1:p1", "ctrl+space"], "alt": true}
{"id": "$id", "ok": true, "result": {"code": 0}}
{"id": "rail", "screen": "w1:p1", "alt": true, "until": "Enter go in"}
{"id": "$id", "ok": true, "result": {"rows": "*"}}
# Enter on the cat row types in its window; what is typed reaches cat.
{"id": "k2", "cli": ["pane", "send-keys", "w1:p1", "down"], "alt": true}
{"id": "$id", "ok": true, "result": {"code": 0}}
{"id": "k3", "cli": ["pane", "send-keys", "w1:p1", "enter"], "alt": true}
{"id": "$id", "ok": true, "result": {"code": 0}}
{"id": "typing-cat", "screen": "w1:p1", "alt": true, "until": "typing here \u00b7 ctrl-space leaves"}
{"id": "$id", "ok": true, "result": {"rows": "*"}}
{"id": "k4", "cli": ["pane", "send-text", "w1:p1", "hello", "--no-enter"], "alt": true}
{"id": "$id", "ok": true, "result": {"code": 0}}
{"id": "k5", "cli": ["pane", "send-keys", "w1:p1", "enter"], "alt": true}
{"id": "$id", "ok": true, "result": {"code": 0}}
{"id": "quiet1", "sleep": 6500}
{"id": "$id", "ok": true, "result": {"slept": true}}
{"id": "typed", "screen": "w1:p1", "alt": true, "until": "hello"}
{"id": "$id", "ok": true, "result": {"rows": "*"}}
{"id": "k6", "cli": ["pane", "send-keys", "w1:p1", "ctrl+space"], "alt": true}
{"id": "$id", "ok": true, "result": {"code": 0}}
# A number key puts the row under the cursor in that window.
{"id": "k7", "cli": ["pane", "send-keys", "w1:p1", "down"], "alt": true}
{"id": "$id", "ok": true, "result": {"code": 0}}
{"id": "k8", "cli": ["pane", "send-text", "w1:p1", "1", "--no-enter"], "alt": true}
{"id": "$id", "ok": true, "result": {"code": 0}}
{"id": "window1", "screen": "w1:p1", "alt": true, "until": "1\u203a e2e idle"}
{"id": "$id", "ok": true, "result": {"rows": "*"}}
