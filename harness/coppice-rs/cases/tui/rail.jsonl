# The floor on a terminal, 100 columns by 36 rows: no room for a window
# beside the rail, so Space peeks. The floor runs in a pane of a second
# scratch server (the alt server), so its own pane is not on the roster
# it draws; it reaches the case's server by the explicit socket. Each
# "screen" is a checkpoint: the floor's screen as the alt server's
# libghostty-vt draws it, plain text and cursor, clocks masked (CP-R-41).
# No pane prints anything, so no state follows the pty's timing. Every
# harness is a fake; no real agent runs. Pane ids on the case's server:
# w1:p1 shell, w1:p2 ask, w1:p3 kid, w1:p4 trust, w1:p5 short, made late
# so it ends at one known point, and alive past a poll, so the floor sees
# it live before it ends.
#!config default = "sh"
#!config [harness.sh]
#!config command = "/bin/sleep"
#!config args = ["600"]
#!config [harness.claude]
#!config command = "/bin/sh"
#!config args = ["-c", "cat \"$1\"; exec sleep 600", "screen"]
{"id": "t1", "cmd": "task.create", "label": "build", "cwd": "{START}"}
{"id": "$id", "ok": true, "result": {"task": "$build", "worktree": ""}}
{"id": "p1", "cmd": "pane.create", "cwd": "{START}", "cmd_argv": ["/bin/sleep", "600"], "label": "e2e shell"}
{"id": "$id", "ok": true, "result": {"pane": "$shell"}}
{"id": "p2", "cmd": "pane.create", "cwd": "{START}", "cmd_argv": ["/bin/sleep", "600"], "label": "e2e ask"}
{"id": "$id", "ok": true, "result": {"pane": "$ask"}}
{"id": "p3", "cmd": "pane.create", "task": "$build", "cmd_argv": ["/bin/sleep", "600"], "label": "kid"}
{"id": "$id", "ok": true, "result": {"pane": "$kid"}}
{"id": "p4", "cmd": "pane.create", "harness": "claude", "cwd": "{START}", "args": ["{FIXTURES}/screens/claude/blocked-10.raw"], "label": "e2e trust", "cols": 160, "rows": 16}
{"id": "$id", "ok": true, "result": {"pane": "$trust"}}
{"id": "r1", "cmd": "pane.report_state", "pane": "$ask", "event": {"v": 1, "ts": 1, "session_id": "s", "harness": "claude-code", "pane": "$ask", "state": "blocked", "source": "gate", "ask": {"id": "toolu_02", "tool": "Write", "summary": "src/main.py", "deadline": 4102444800, "tier": "undoable"}, "detail": "verdict=ask"}}
{"id": "$id", "ok": true, "result": {"pane": "$ask", "state": "blocked", "source": "gate"}}
#!retry 8000
{"id": "x4", "cmd": "pane.explain", "pane": "$trust"}
{"id": "$id", "ok": true, "result": {"pane": "$trust", "rule_id": "coppice_first_run_trust"}}
{"id": "a1", "cli": ["server", "start"], "alt": true, "autostart": true}
{"id": "$id", "ok": true, "result": {"code": 0}}
{"id": "a2", "cli": ["pane", "create", "--json", "--label", "floor", "--kind", "pty", "--cols", "100", "--rows", "36", "--cwd", "{START}", "--", "/usr/bin/env", "-u", "COPPICE_PANE", "{BIN}", "--socket", "{SOCK}", "--data-dir", "{DATA}"], "alt": true}
{"id": "$id", "ok": true, "result": {"code": 0}}
{"id": "roster", "screen": "w1:p1", "alt": true, "until": "2 need you"}
{"id": "$id", "ok": true, "result": {"rows": "*"}}
# shift-tab goes to a pane that needs you, and Space peeks at it.
