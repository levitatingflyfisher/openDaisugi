{"id": "f9", "http": "GET", "url": "http://{ADDR}/plugins/myview/"}
{"id": "$id", "ok": true, "result": {"status": 200}}
{"id": "f10", "http": "GET", "url": "http://{ADDR}/plugins/myview/app.js"}
{"id": "$id", "ok": true, "result": {"status": 200}}
{"id": "f11", "http": "GET", "url": "http://{ADDR}/plugins/myview/_secret.js"}
{"id": "$id", "ok": true, "result": {"status": 404}}
{"id": "f12", "http": "GET", "url": "http://{ADDR}/plugins/myview/sub/x.css"}
{"id": "$id", "ok": true, "result": {"status": 200}}
{"id": "f13", "http": "GET", "url": "http://{ADDR}/plugins/myview/sub/blob.bin"}
{"id": "$id", "ok": true, "result": {"status": 200}}
{"id": "f14", "http": "GET", "url": "http://{ADDR}/plugins/myview/sub"}
