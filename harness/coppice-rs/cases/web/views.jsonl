# The shared library: top-level JavaScript files only.
{"id": "b1", "http": "GET", "url": "http://{ADDR}/plugins/_lib/view.js"}
{"id": "$id", "ok": true, "result": {"status": 200}}
{"id": "b2", "http": "GET", "url": "http://{ADDR}/plugins/_lib/layout.js"}
{"id": "$id", "ok": true, "result": {"status": 200}}
