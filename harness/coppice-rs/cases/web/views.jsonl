{"id": "f15", "http": "GET", "url": "http://{ADDR}/plugins/myview/sub/"}
{"id": "$id", "ok": true, "result": "*"}
{"id": "f16", "http": "GET", "url": "http://{ADDR}/plugins/myview/../tree/tree.js"}
{"id": "$id", "ok": true, "result": "*"}
{"id": "f17", "http": "GET", "url": "http://{ADDR}/plugins/myview/%2e%2e/tree/tree.js"}
{"id": "$id", "ok": true, "result": "*"}
{"id": "f18", "http": "HEAD", "url": "http://{ADDR}/plugins/myview/app.js"}
{"id": "$id", "ok": true, "result": {"status": 200}}
{"id": "f19", "http": "POST", "url": "http://{ADDR}/plugins/myview/app.js"}
{"id": "$id", "ok": true, "result": {"status": 405}}
{"id": "f20", "http": "GET", "url": "http://{ADDR}/plugins/myview/manifest.json"}
{"id": "$id", "ok": true, "result": {"status": 200}}
{"id": "f21", "http": "GET", "url": "http://{ADDR}/plugins/myview/.hidden"}
