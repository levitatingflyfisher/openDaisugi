# View plugins on the web server: the list, each view's files under the
# view's own policy, the shared library, and what is never served.
#!plugins userviews
#!config plugins = ["tree", "minimap", "myview"]
{"id": "w0", "write": "{DATA}/web/token", "text": "pinned-web-token-0001\n"}
{"id": "$id", "ok": true, "result": {"written": true}}
{"id": "v1", "cli": ["web", "serve", "--tls", "off", "--listen", "{ADDR}", "--qr=false"], "bg": "web"}
{"id": "$id", "ok": true, "result": {"started": true}}
{"id": "l1", "http": "GET", "url": "http://{ADDR}/api/views", "headers": {"Authorization": "Bearer pinned-web-token-0001"}, "wait_ms": 8000}
{"id": "$id", "ok": true, "result": {"status": 200}}
{"id": "f1", "http": "GET", "url": "http://{ADDR}/plugins/tree/"}
{"id": "$id", "ok": true, "result": {"status": 200}}
{"id": "f2", "http": "GET", "url": "http://{ADDR}/plugins/tree/index.html"}
{"id": "$id", "ok": true, "result": {"status": 200}}
{"id": "f3", "http": "GET", "url": "http://{ADDR}/plugins/tree/tree.js"}
{"id": "$id", "ok": true, "result": {"status": 200}}
{"id": "f4", "http": "GET", "url": "http://{ADDR}/plugins/tree/tree.css"}
{"id": "$id", "ok": true, "result": {"status": 200}}
{"id": "f5", "http": "GET", "url": "http://{ADDR}/plugins/tree/manifest.json"}
{"id": "$id", "ok": true, "result": {"status": 200}}
{"id": "f6", "http": "GET", "url": "http://{ADDR}/plugins/tree/_tests/x.js"}
{"id": "$id", "ok": true, "result": {"status": 404}}
{"id": "f7", "http": "GET", "url": "http://{ADDR}/plugins/tree"}
{"id": "$id", "ok": true, "result": "*"}
