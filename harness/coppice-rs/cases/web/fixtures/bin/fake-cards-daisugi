#!/bin/sh
# A fake daisugi for the cards and tree routes of the phone server. It
# never reads a ranking. The canned replies are fixed, and a call that
# should not happen exits 9.
#   rank queue --json --sort S [--data-dir D]
#   rank show --choice ID --json [--data-dir D]
#   rank record drop ID --json | rank record pick ID PICK --json
#   tree prune-branches --json | tree status --json | tree answer ASK VERDICT
# The steward's work dir is the one data dir that ends in /foreman/work.
case "$*" in *"--data-dir "*/foreman/work) steward=1 ;; *) steward=0 ;; esac
case "$1 $2" in
"rank queue")
  echo '{"cards":[{"choice_id":"ch_1","headline":"Kept a over b.","alternatives":["b"]}],"decayed":0}' ;;
"rank show")
  case "$4" in
  ch_1) echo '{"choices":[{"event":"opened","facts":{"order":["a","b"],"where":{"a":{"kind":"output","text":"x"}}}}]}' ;;
  *) echo "There is no choice $4." >&2; exit 1 ;;
  esac ;;
"rank record")
  case "$3" in
  drop) [ "$4" = "ch_1" ] || { echo "There is no choice $4." >&2; exit 1; }; echo '{"recorded":true,"outcome":"confirmed"}' ;;
  pick) [ "$4" = "ch_1" ] || { echo "There is no choice $4." >&2; exit 1; }; echo "{\"recorded\":true,\"outcome\":\"overridden\",\"pick\":\"$5\"}" ;;
  esac ;;
"tree prune-branches") echo '{"removed":["s1"]}' ;;
"tree status")
  if [ "$steward" = 1 ]; then
    echo '{"nodes":[{"session":"s1","state":"running"},{"session":"n-w","state":"ended"}],"asks":[{"ask_id":"a2"}],"skipped":2}'
  else
    echo '{"nodes":[{"session":"s1","state":"running"}],"asks":[{"ask_id":"a1"}],"skipped":0}'
  fi ;;
"tree answer")
  if [ "$steward" = 1 ]; then ok="a2"; else ok="a1"; fi
  [ "$3" = "$ok" ] || { echo "There is no ask $3." >&2; exit 1; }
  echo "{\"answered\":\"$4\"}" ;;
*) echo "fake cards daisugi: unknown command $*" >&2; exit 9 ;;
esac
