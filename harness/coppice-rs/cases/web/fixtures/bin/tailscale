#!/bin/sh
# A fake tailscale for the web cases and the unit tests. It never touches
# a network or a real tailnet.
#
#   tailscale status --json
#       Prints this box as tailscale does: BackendState, Self.DNSName with
#       its trailing dot, Self.TailscaleIPs, and CertDomains.
#   tailscale cert --cert-file C --key-file K NAME
#       Writes a self-signed certificate for NAME and its key, made with
#       openssl, that runs out in FAKE_TS_DAYS days and 12 hours. A name that starts
#       with "fail" exits 1, as tailscale does when HTTPS is off.
#
# The knobs, all environment variables:
#   FAKE_TS_NAME   the MagicDNS name, default box.tail1.ts.net
#   FAKE_TS_IPS    the tailnet addresses, comma separated, default
#                  127.0.0.2, a loopback address a test can bind and reach
#   FAKE_TS_STATE  BackendState, default Running
#   FAKE_TS_HTTPS  off leaves CertDomains empty, as when HTTPS is off
#   FAKE_TS_DAYS   how long a new certificate lasts, default 90
#   FAKE_TS_LOG    a file that gets one line per call: the arguments
#   FAKE_TS_CERT_FAIL  set: tailscale cert fails, as when the certificate
#                  service does not answer
#   FAKE_TS_CERT_FAIL_FILE  the same while this file says fail
#   FAKE_TS_UP_FILE  while this file does not say up, tailscale is still
#                  starting: BackendState Starting and no address
#   FAKE_TS_PEERS_FILE  a file that holds the JSON object of the Peer table
#                  (node key to HostName, DNSName, OS, Online, LastSeen,
#                  TailscaleIPs). Without it the box has no peers.
#   FAKE_TS_FAIL   status exits 1, as when tailscaled does not run
#   FAKE_TS_SLEEP  status waits this many seconds before it answers
name_default="${FAKE_TS_NAME:-box.tail1.ts.net}"
if [ -n "$FAKE_TS_LOG" ]; then
  printf '%s\n' "$*" >> "$FAKE_TS_LOG"
fi
case "$1" in
  status)
    ips=""
    old_ifs="$IFS"; IFS=','
    for ip in ${FAKE_TS_IPS:-127.0.0.2}; do
      [ -n "$ips" ] && ips="$ips, "
      ips="$ips\"$ip\""
    done
    IFS="$old_ifs"
    domains="\"$name_default\""
    [ "$FAKE_TS_HTTPS" = off ] && domains=""
    state="${FAKE_TS_STATE:-Running}"
    # Tailscale still starting, as at boot: no address until the file
    # FAKE_TS_UP_FILE names says up.
    if [ -n "$FAKE_TS_UP_FILE" ] && [ "$(cat "$FAKE_TS_UP_FILE" 2>/dev/null)" != up ]; then
      state=Starting
      ips=""
    fi
    [ -n "$FAKE_TS_FAIL" ] && { echo "failed to connect to local tailscaled" >&2; exit 1; }
    [ -n "$FAKE_TS_SLEEP" ] && sleep "$FAKE_TS_SLEEP"
    peers="{}"
    [ -n "$FAKE_TS_PEERS_FILE" ] && peers="$(cat "$FAKE_TS_PEERS_FILE")"
    cat <<EOF
{
  "Version": "1.90.0-fake",
  "BackendState": "$state",
  "TailscaleIPs": [$ips],
  "Self": {
    "HostName": "box",
    "DNSName": "$name_default.",
    "OS": "linux",
    "Online": true,
    "TailscaleIPs": [$ips]
  },
  "Peer": $peers,
  "MagicDNSSuffix": "tail1.ts.net",
  "CertDomains": [$domains]
}
EOF
    exit 0
    ;;
  cert) ;;
  *) echo "fake tailscale: unknown command $1" >&2; exit 2 ;;
esac
for a in "$@"; do
  case "$a" in
    --cert-file=*) cert="${a#--cert-file=}" ;;
    --key-file=*) key="${a#--key-file=}" ;;
    -*|cert) ;;
    *) name="$a" ;;
  esac
done
case "$name" in fail*) echo "fake tailscale: HTTPS is off" >&2; exit 1 ;; esac
if [ -n "$FAKE_TS_CERT_FAIL" ] || { [ -n "$FAKE_TS_CERT_FAIL_FILE" ] && [ "$(cat "$FAKE_TS_CERT_FAIL_FILE" 2>/dev/null)" = fail ]; }; then
  echo "fake tailscale: the certificate service did not answer" >&2
  exit 1
fi
# The certificate runs out FAKE_TS_DAYS days and 12 hours from now (CP-R-48).
# A caller takes its own clock before or after this run, some seconds away
# from the start time openssl writes in whole seconds. With half a day over
# the whole days, the whole days left (rounded down) read FAKE_TS_DAYS on
# either side of the run. A whole day over read FAKE_TS_DAYS + 1 when the
# caller took its clock in a second before the start. openssl req -days
# counts whole days and -not_after needs openssl 3.4, so openssl ca signs
# with exact dates; it works on every openssl.
days="${FAKE_TS_DAYS:-90}"
work=$(mktemp -d) || exit 1
trap 'rm -rf "$work"' EXIT
now=$(date -u +%s)
start=$(date -u -d "@$now" +%Y%m%d%H%M%SZ)
end=$(date -u -d "@$((now + days * 86400 + 43200))" +%Y%m%d%H%M%SZ)
: > "$work/index"
echo 01 > "$work/serial"
cat > "$work/ca.cnf" <<EOF
[ca]
default_ca = fake
[fake]
database = $work/index
new_certs_dir = $work
serial = $work/serial
default_md = sha256
policy = any
unique_subject = no
x509_extensions = ext
[any]
commonName = supplied
[ext]
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid:always
basicConstraints = critical, CA:TRUE
subjectAltName = DNS:$name
EOF
if ! openssl req -new -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \
  -keyout "$key.new" -out "$work/req" -subj "/CN=$name" >/dev/null 2>&1 ||
  ! openssl ca -batch -selfsign -notext -config "$work/ca.cnf" -keyfile "$key.new" \
  -in "$work/req" -out "$cert.new" -startdate "$start" -enddate "$end" >/dev/null 2>&1; then
  echo "fake tailscale: openssl failed" >&2
  exit 1
fi
chmod 600 "$key.new"
mv "$key.new" "$key"
mv "$cert.new" "$cert"
echo "Wrote public cert to $cert"
echo "Wrote private key to $key"
