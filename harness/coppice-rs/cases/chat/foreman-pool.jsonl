# Worker pools and the queue (FM-R-93 to FM-R-101). A worker profile may name
# a pool in pools.toml: entries (machine, base URL) that serve ONE model. A
# spawn takes the first entry with a free slot, else the job waits in a
# queue that `coppice foreman queue` shows. The fake daisugi (cases/chat/
# fixtures/fake-daisugi.py) logs the base URL its run got, and waits for a
# go file, so each worker ends when the case says. A model that is not the
# pool's model is refused. A run on an entry that does not answer cools the
# entry, and the job moves to the other entry of the same pool; when the
# quota is out on both the job is requeued and the foreman says so (that
# line holds a clock time, which CP-R-58 masks). A local pool goes on.
#!config projects = ["{WORK}/proj"]
#!config [foreman]
#!config mode = "chat"
#!env COPPICE_CLAUDE_BIN={FIXTURES}/chat/fake-turn-claude.py
#!env COPPICE_DAISUGI_BIN={FIXTURES}/chat/fake-daisugi.py
#!env FAKE_TURN_DIR={WORK}/turns
#!env FAKE_TREE_LOG={WORK}/tree.log
#!env FAKE_TREE_START={WORK}/start.log
#!env FAKE_TREE_GO={WORK}/go
#!env FAKE_BUNDLE_FILE={WORK}/bundle.json
#!env FAKE_FAIL_FILE={WORK}/fail.txt
#!env FAKE_FAIL_DELAY=4
#!env COPPICE_TEST_HOOKS=1
#!env COPPICE_IMPORT_POLL_MS=100
{"id":"w1","write":"{WORK}/proj/README","text":"a project\n"}
{"id":"$id","ok":true,"result":{"written":true}}
{"id":"w2","write":"{HOME}/.config/coppice/envelopes/proj.json","text":"{\"envelope\": {\"tools\": [\"read\"], \"paths\": [\"<repo>\"]}, \"tokens\": 5000, \"turns\": 3}"}
{"id":"$id","ok":true,"result":{"written":true}}
{"id":"w3","write":"{WORK}/bundle.json","text":"{\"desk\":{\"wire\":\"openai\",\"base_url\":\"http://127.0.0.1:1/v1\",\"model\":\"m1\",\"key_env\":null,\"key\":null},\"cloud\":{\"wire\":\"openai\",\"base_url\":\"http://127.0.0.1:1/v1\",\"model\":\"m2\",\"key_env\":null,\"key\":null},\"local\":{\"wire\":\"openai\",\"base_url\":\"http://127.0.0.1:1/v1\",\"model\":\"m4\",\"key_env\":null,\"key\":null}}"}
{"id":"$id","ok":true,"result":{"written":true}}
{"id":"w4","write":"{HOME}/.config/coppice/pools.toml","text":"idle_after = \"1s\"\n[pool.desk]\nmodel = \"m1\"\n[[pool.desk.entries]]\nname = \"a\"\nbase_url = \"http://127.0.0.1:11/v1\"\n[[pool.desk.entries]]\nname = \"b\"\nbase_url = \"http://127.0.0.1:12/v1\"\n[pool.cloud]\nmodel = \"m2\"\n[[pool.cloud.entries]]\nname = \"c\"\nbase_url = \"http://127.0.0.1:21/v1\"\n[[pool.cloud.entries]]\nname = \"d\"\nbase_url = \"http://127.0.0.1:22/v1\"\n[pool.local]\nmodel = \"m4\"\n[[pool.local.entries]]\nname = \"l\"\nbase_url = \"http://127.0.0.1:23/v1\"\n"}
{"id":"$id","ok":true,"result":{"written":true}}
{"id":"1","cmd":"floor.talk","text":"spawn proj profile=desk ran1"}
{"id":"$id","ok":true,"result":{"message":"log/0"}}
#!retry 20000
{"id":"2","cmd":"floor.chat"}
{"id":"$id","ok":true,"result":{"messages":[{"id":"log/0"},{"id":"log/1","role":"agent","tool":"spawn"},{"id":"log/2","role":"agent","text":"tools zoom,date,spawn,status; spawn gave error=False: started proj-1 on a"}]}}
