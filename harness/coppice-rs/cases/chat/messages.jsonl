# pane.messages reads one pane's transcript: a Claude transcript only when
# a process inside the pane named it (each pane runs report.py, which names
# it once the case writes a go file), and a sprig session tree from the
# pane's record. A transcript another pane named first, live or ended,
# through a symlinked spelling too, one older than the pane, one whose
# first record has no working directory, or one that began in another
# directory, is refused; the rest of the report still counts, and the
# claim outlives a restart. Only the operator resumes or forks another
# pane's sprig session. Tool use shows as its name and one
# line of input, and no tool output ever shows. A pane reads only its own
# messages. The phone server's websocket is a second connection: the
# owner's token reads any pane, and a named token reads none. The fixtures
# are invented.
#!env COPPICE_SPRIG_BIN={FIXTURES}/adapters/fake-sprig.sh
#!config [harness.claude]
#!config command = "/usr/bin/python3"
#!config args = ["{FIXTURES}/transcripts/report.py"]
{"id":"w0","write":"{DATA}/web/token","text":"pinned-web-token-0001\n"}
{"id":"$id","ok":true,"result":{"written":true}}
{"id":"w1","write":"{DATA}/web/token-names.json","text":"{\"tokens\":[{\"name\":\"kid\",\"token\":\"kid-token-0001\"}]}"}
{"id":"$id","ok":true,"result":{"written":true}}
{"id":"w2","write":"{WORK}/claude/projects/old/old.jsonl","text":"{\"type\":\"user\",\"timestamp\":\"2020-01-01T00:00:00Z\",\"cwd\":\"{FIXTURES}\",\"message\":{\"content\":\"FAKE-OLD\"}}\n"}
{"id":"$id","ok":true,"result":{"written":true}}
{"id":"w3","write":"{WORK}/claude/projects/bare/bare.jsonl","text":"{\"type\":\"user\",\"timestamp\":\"2099-01-01T00:00:00Z\",\"message\":{\"content\":\"FAKE-BARE\"}}\n"}
{"id":"$id","ok":true,"result":{"written":true}}
{"id":"1","cmd":"pane.create","cwd":"{FIXTURES}","harness":"claude","label":"alpha","args":["{WORK}/claude/projects/chat/{pane}.jsonl","--copy","{FIXTURES}/transcripts/claude-chat.jsonl","--when","{WORK}/go-alpha"],"env":{"CLAUDE_CONFIG_DIR":"{WORK}/claude"}}
{"id":"$id","ok":true,"result":{"pane":"$c"}}
{"id":"2","cmd":"pane.messages","pane":"$c"}
{"id":"$id","ok":false,"error":{"code":"bad_request","message":"alpha (w1:p1) has no transcript to read. Its hook reported none."}}
{"id":"3","cmd":"pane.messages","pane":"w9:p9"}
{"id":"$id","ok":false,"error":{"code":"no_such_pane"}}
{"id":"4","write":"{WORK}/go-alpha","text":"go\n"}
{"id":"$id","ok":true,"result":{"written":true}}
{"id":"5","cmd":"pane.wait_output","pane":"$c","contains":"REPORT ok","timeout_ms":10000}
{"id":"$id","ok":true,"result":{"matched":"text"}}
{"id":"6","cmd":"pane.messages","pane":"$c"}
{"id":"$id","ok":true,"result":{"source":"transcript","more":false,"messages":[{"id":"67","role":"owner","text":"fix the fake test, it fails on CI"},{"id":"669","role":"agent","text":"The test reads a clock.\nI give it a fake one.[31m"},{"id":"923","role":"agent","text":"Running the suite."},{"id":"923.1","role":"agent","text":"pytest tests/test_fake.py -q","tool":"Bash"},{"id":"2276","role":"owner","text":"now push it, please"},{"id":"2494","role":"agent","text":"/fake/src/clock.py","tool":"Read"},{"id":"2494.1","role":"agent","text":"","tool":"Glob"},{"id":"2792","role":"agent","text":"A fake reply with no time."}]}}
{"id":"7","cmd":"pane.messages","pane":"$c","since":"923.1","limit":3}
{"id":"$id","ok":true,"result":{"more":true,"messages":[{"id":"2494"},{"id":"2494.1"},{"id":"2792"}]}}
{"id":"8","cmd":"pane.messages","pane":"$c","since":"2792"}
{"id":"$id","ok":true,"result":{"more":false,"messages":[]}}
