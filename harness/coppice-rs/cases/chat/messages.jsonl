# The phone: the owner's token reads both, a named token neither. One
# request to each websocket, since the phone server may answer out of
# order.
{"id":"s1","ws":"ws://{ADDR}/ws","protocols":["daisugi.v1","daisugi.bearer.pinned-web-token-0001"],"send":["{\"id\":\"1\",\"cmd\":\"pane.messages\",\"pane\":\"w1:p1\",\"limit\":1}"]}
{"id":"$id","ok":true,"result":{"status":101,"frames":[{"id":"1","ok":true,"result":{"more":true,"messages":[{"id":"2792"}]}}]}}
{"id":"s2","ws":"ws://{ADDR}/ws","protocols":["daisugi.v1","daisugi.bearer.pinned-web-token-0001"],"send":["{\"id\":\"2\",\"cmd\":\"pane.messages\",\"pane\":\"w1:p2\"}"]}
{"id":"$id","ok":true,"result":{"status":101,"frames":[{"id":"2","ok":false,"error":{"code":"bad_request"}}]}}
{"id":"s3","ws":"ws://{ADDR}/ws","protocols":["daisugi.v1","daisugi.bearer.pinned-web-token-0001"],"send":["{\"id\":\"3\",\"cmd\":\"floor.chat\"}"]}
