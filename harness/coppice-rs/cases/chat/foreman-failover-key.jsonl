# A refused key (HTTP 401) is a key problem, not a quota: the turn fails with
# a note that says so, and the chain does not move (FM-R-47). work never
# runs, so the status holds no cooling account.
#!config [foreman]
#!config mode = "chat"
#!config turn_profiles = ["desk", "work"]
#!config turn_model = "m1"
#!env COPPICE_SPRIG_BIN={FIXTURES}/chat/fake-turn-sprig.py
#!env COPPICE_DAISUGI_BIN={FIXTURES}/chat/fake-daisugi.py
#!env FAKE_BUNDLE_FILE={WORK}/bundle.json
{"id":"w1","write":"{WORK}/bundle.json","text":"{\"desk\":{\"wire\":\"anthropic\",\"base_url\":null,\"model\":\"m1\",\"key\":\"sk-401-0001\"},\"work\":{\"wire\":\"anthropic\",\"base_url\":null,\"model\":\"m1\",\"key\":\"sk-work-0001\"}}"}
{"id":"$id","ok":true,"result":{"written":true}}
{"id":"1","cmd":"floor.talk","text":"one"}
{"id":"$id","ok":true,"result":{"mode":"chat","message":"log/0","queued":1,"label":"foreman"}}
#!retry 20000
{"id":"2","cmd":"floor.chat"}
{"id":"$id","ok":true,"result":{"source":"log","more":false,"messages":[{"id":"log/0","role":"owner","text":"one","read":true},{"id":"log/1","role":"note","text":"The foreman's turn failed: HTTP 401: the key was refused. That is a key problem, not a quota on desk, so the foreman did not move to the next profile. Say it again to try again."}]}}
{"id":"3","file":"{DATA}/foreman/failover.json","count":"\"state\":\"failing\""}
{"id":"$id","ok":true,"result":{"count":1}}
{"id":"4","file":"{DATA}/foreman/failover.json","count":"\"state\":\"cooling\""}
{"id":"$id","ok":true,"result":{"count":0}}
