# Import of old Claude Code and Codex chats (FM-R-71 to FM-R-85). Fake
# transcripts are written under the side's own HOME; nothing real is read. The
# poll is off (a test knob, FM-R-84), so the compactor loop feeds only when a
# verb wakes it, and the cases do not race the loop. coppice foreman import is
# the owner's command; floor.import is the same choice for the floor. Nothing
# is masked: the first case waits for the startup scan (the home is empty then,
# so the estimate is 0 and 0), so every later estimate is the same on both
# sides, and the case before the decline reads the estimate of the floor's
# path, which counts a message at the last time as new (CP-R-60).
#!config [foreman]
#!config mode = "chat"
#!env COPPICE_TEST_HOOKS=1
#!env COPPICE_IMPORT_POLL_MS=off
#!retry 20000
{"id":"s0","cmd":"floor.import"}
{"id":"$id","ok":true,"result":{"state":"off","offered":false,"paused":false,"done":0,"total":0,"queued":0,"sessions":0,"messages":0,"estimating":false}}
{"id":"p0","cmd":"floor.import","action":"progress"}
{"id":"$id","ok":true,"result":{"state":"off","offered":false,"paused":false,"done":0,"total":0,"queued":0,"sessions":0,"messages":0,"estimating":false}}
{"id":"w1","write":"{HOME}/.claude/projects/p/s1.jsonl","text":"{\"type\":\"user\",\"uuid\":\"u1\",\"sessionId\":\"s1\",\"timestamp\":\"2026-03-01T10:00:00.000Z\",\"cwd\":\"/w/proj\",\"message\":{\"role\":\"user\",\"content\":\"hello there\"}}\n{\"type\":\"assistant\",\"uuid\":\"a1\",\"sessionId\":\"s1\",\"timestamp\":\"2026-03-01T10:00:05.000Z\",\"cwd\":\"/w/proj\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"secret\"},{\"type\":\"text\",\"text\":\"hi\"},{\"type\":\"tool_use\",\"name\":\"Bash\",\"input\":{\"command\":\"ls\"}}]}}\n{\"type\":\"user\",\"uuid\":\"u2\",\"sessionId\":\"s1\",\"timestamp\":\"2026-03-02T09:00:00.000Z\",\"cwd\":\"/w/proj\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"thanks\"}]}}\n"}
{"id":"$id","ok":true,"result":{"written":true}}
{"id":"w2","write":"{HOME}/.codex/sessions/2026/03/05/rollout-2026-03-05T08-00-00-c1.jsonl","text":"{\"timestamp\":\"2026-03-05T08:00:00.000Z\",\"type\":\"session_meta\",\"payload\":{\"id\":\"c1\",\"cwd\":\"/w/o\"}}\n{\"timestamp\":\"2026-03-05T08:00:02.000Z\",\"type\":\"response_item\",\"payload\":{\"type\":\"message\",\"role\":\"user\",\"content\":[{\"type\":\"input_text\",\"text\":\"write a test\"}]}}\n{\"timestamp\":\"2026-03-05T08:00:04.000Z\",\"type\":\"response_item\",\"payload\":{\"type\":\"function_call\",\"name\":\"shell\",\"arguments\":\"{\\\"command\\\": [\\\"bash\\\", \\\"-lc\\\", \\\"go test\\\"]}\",\"call_id\":\"k1\"}}\n{\"timestamp\":\"2026-03-05T08:00:07.000Z\",\"type\":\"response_item\",\"payload\":{\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"text\":\"written\"}]}}\n"}
{"id":"$id","ok":true,"result":{"written":true}}
{"id":"1","cli":["foreman","import","--dry-run"]}
{"id":"$id","ok":true,"result":{"code":0,"stdout":"past chats: 2 (about 5 messages)\n  claude: 1 chat, 3 messages\n  codex: 1 chat, 2 messages\nnothing was changed\n","stderr":""}}
