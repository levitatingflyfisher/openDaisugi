# A pane reading floor.journal gets only its own pane's entries, whichever
# pane it asks for; a pane that asks for another's gets none. An operator
# (the connection before its hello) gets all. A hello that names a pane
# narrows the connection for good, so the pane checks come last.
{"id":"1","cmd":"pane.create","cwd":"{FIXTURES}","cmd_argv":["/bin/sleep","600"]}
{"id":"$id","ok":true,"result":{"pane":"$a"}}
