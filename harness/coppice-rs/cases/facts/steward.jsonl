# floor.talk starts the floor's steward with the default harness, in the
# steward's own directory, labelled steward. The words wait in a queue. The
# steward first gets its page, as one paste since its program turns on
# bracketed paste, and then the words, in order. The fake harness is cat,
# so the words come back on its screen.
#!config default = "fake"
#!config [harness.fake]
#!config command = "{FIXTURES}/fake-steward.sh"
#!watch state,note
#!settle 300
{"id":"1","cmd":"floor.talk","text":"hello\tsteward\u0007"}
{"id":"$id","ok":true,"result":{"pane":"$f","label":"steward","started":true,"queued":1}}
{"id":"2","cmd":"floor.steward"}
{"id":"$id","ok":false,"error":{"code":"bad_request","message":"the steward steward (w1:p1) runs already. Close it first, or talk to it."}}
{"id":"3","cmd":"floor.talk","text":"second line"}
{"id":"$id","ok":true,"result":{"pane":"$f","label":"steward","started":false,"queued":2}}
{"id":"6","cmd":"pane.wait_output","pane":"$f","contains":"second line","timeout_ms":40000}
{"id":"$id","ok":true,"result":{"matched":"text"}}
{"id":"7","cmd":"pane.wait_output","pane":"$f","contains":"hello steward","timeout_ms":1000}
{"id":"$id","ok":true,"result":{"matched":"text"}}
# The facts and the list come once the steward drew the words, so each
# server reads its output as of the last 5 s (CP-R-50). Read before it
# drew, the state hung on whether the fake had printed yet.
{"id":"4","cmd":"floor.facts"}
{"id":"$id","ok":true,"result":{"steward":{"pane":"$f","label":"steward"}}}
{"id":"5","cmd":"pane.list"}
{"id":"$id","ok":true,"result":{"panes":[{"id":"$f","label":"steward","harness":"fake","cwd":"{HOME}/.local/state/coppice-steward"}],"path":"*"}}
{"id":"8","cmd":"pane.close","pane":"$f"}
{"id":"$id","ok":true,"result":{"pane":"$f","closed":true}}
{"id":"9","cmd":"floor.steward","harness":"fake"}
{"id":"$id","ok":true,"result":{"pane":"$f2","label":"steward","started":true}}
{"id":"10","cmd":"floor.talk","text":"third"}
{"id":"$id","ok":true,"result":{"pane":"$f2","started":false,"queued":1}}
