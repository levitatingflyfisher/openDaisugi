<mujoco model="grip_ctrlrange">
  <!-- A one-joint arm whose gripper has a control range and no joint
       range, a joint no actuator drives, and two unnamed geoms that touch
       at rest. -->
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 0"/>
  <worldbody>
    <body name="arm" pos="0 0 0">
      <joint name="j1" type="hinge" axis="0 0 1" range="-3.14 3.14"/>
      <geom type="box" size="0.05 0.05 0.05" pos="0.1 0 0" contype="1" conaffinity="1"/>
      <body name="end_effector" pos="0.1 0 0">
        <joint name="j_grip" type="slide" axis="0 1 0" damping="1.0"/>
        <geom type="box" size="0.01 0.01 0.01" contype="0" conaffinity="0"/>
      </body>
    </body>
    <body name="wall" pos="0.1 0 0">
      <geom type="box" size="0.05 0.05 0.05" contype="1" conaffinity="1"/>
    </body>
    <body name="idle" pos="0 1 0">
      <joint name="j_free" type="hinge" axis="0 0 1"/>
      <geom type="sphere" size="0.01" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
  <actuator>
    <position name="a1" joint="j1" kp="50"/>
    <position name="a_grip" joint="j_grip" kp="100" ctrlrange="-0.02 0.03"/>
  </actuator>
</mujoco>
